<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/user.css">
</head>
<body>
    <%- include('../partials/user-navbar') %>

    <% if (success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success">
            <%= success_msg %>
        </div>
    <% } %>
    <% if (error_msg && error_msg.length > 0) { %>
        <div class="alert alert-error">
            <%= error_msg %>
        </div>
    <% } %>

    <main class="user-main">
        <%- body %>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/user.js"></script>
    <% if (user) { %>
    <script>
        // Socket.io bağlantısı
        const socket = io({
            transports: ['websocket', 'polling']
        });

        // Kullanıcı ID
        const userId = <%= user.id %>;

        socket.on('connect', () => {
            console.log('Socket.io bağlandı');
            socket.emit('join-user', userId);
            socket.emit('subscribe-bicoin', userId);
            socket.emit('subscribe-predictions');
            socket.emit('subscribe-leaderboard');
        });

        // Bi! Coin güncelleme
        socket.on('bicoin-update', (data) => {
            // Navbar'daki bi coin
            const biCoinElements = document.querySelectorAll('.bi-badge span');
            biCoinElements.forEach(el => {
                if (data.bi_coin !== undefined) {
                    el.textContent = parseInt(data.bi_coin).toLocaleString('tr-TR');
                    el.classList.add('bicoin-updated');
                    setTimeout(() => el.classList.remove('bicoin-updated'), 500);
                }
            });

            // Wallet card'daki bi coin
            const walletAmount = document.querySelector('.wallet-amount span');
            if (walletAmount && data.bi_coin !== undefined) {
                walletAmount.textContent = parseInt(data.bi_coin).toLocaleString('tr-TR');
            }

            // Profile stat'daki bi coin
            const profileBiCoin = document.querySelector('.profile-stat-value.bi');
            if (profileBiCoin && data.bi_coin !== undefined) {
                profileBiCoin.textContent = parseInt(data.bi_coin).toLocaleString('tr-TR');
            }
        });

        // Bildirim güncelleme
        socket.on('notification', (data) => {
            const notifDot = document.querySelector('.notification-dot');
            if (notifDot) {
                notifDot.style.display = 'block';
            }
            if (data.message) {
                showNotification(data.message, data.type || 'info');
            }
        });

        // Tahmin güncelleme
        socket.on('prediction-update', (data) => {
            if (typeof updatePredictionUI === 'function') {
                updatePredictionUI(data);
            }
        });

        // Görev güncelleme
        socket.on('task-update', (data) => {
            if (typeof updateTaskUI === 'function') {
                updateTaskUI(data);
            }
        });

        socket.on('disconnect', () => {
            console.log('Socket.io bağlantısı kesildi');
        });

        socket.on('connect_error', (error) => {
            console.log('Socket.io bağlantı hatası, polling kullanılıyor');
        });

        // Bildirim gösterme fonksiyonu
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `toast-notification toast-${type}`;
            notification.innerHTML = `
                <span>${message}</span>
                <button onclick="this.parentElement.remove()">&times;</button>
            `;
            document.body.appendChild(notification);
            setTimeout(() => notification.remove(), 5000);
        }
    </script>
    <% } %>
</body>
</html>
