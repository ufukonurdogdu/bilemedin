<div class="page-container">
    <div class="page-header-section">
        <h1>İletişim</h1>
        <p>Bizimle iletişime geçin</p>
    </div>

    <div class="contact-grid">
        <div class="contact-info">
            <h2>İletişim Bilgileri</h2>
            
            <div class="contact-item">
                <div class="contact-icon">📧</div>
                <div>
                    <h4>E-posta</h4>
                    <p>info@bilemezsin.com</p>
                </div>
            </div>

            <div class="contact-item">
                <div class="contact-icon">📍</div>
                <div>
                    <h4>Adres</h4>
                    <p>İstanbul, Türkiye</p>
                </div>
            </div>

            <div class="contact-item">
                <div class="contact-icon">💬</div>
                <div>
                    <h4>Sosyal Medya</h4>
                    <div class="social-links-contact">
                        <a href="#">Twitter</a>
                        <a href="#">Instagram</a>
                        <a href="#">Facebook</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="contact-form-section">
            <h2>Bize Yazın</h2>
            <form class="contact-form">
                <div class="form-group">
                    <label for="name">Ad Soyad</label>
                    <input type="text" id="name" name="name" placeholder="Adınız Soyadınız" required>
                </div>
                <div class="form-group">
                    <label for="email">E-posta</label>
                    <input type="email" id="email" name="email" placeholder="ornek@email.com" required>
                </div>
                <div class="form-group">
                    <label for="subject">Konu</label>
                    <select id="subject" name="subject">
                        <option value="">Konu Seçin</option>
                        <option value="genel">Genel Soru</option>
                        <option value="teknik">Teknik Destek</option>
                        <option value="oneri">Öneri</option>
                        <option value="sikayet">Şikayet</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="message">Mesaj</label>
                    <textarea id="message" name="message" rows="5" placeholder="Mesajınızı yazın..." required></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Gönder</button>
            </form>
        </div>
    </div>
</div>
