<div class="dashboard-container">
    <div class="page-header">
        <h1>Profil Düzenle</h1>
        <p>Profil bilgilerini güncelle</p>
    </div>

    <div class="settings-grid">
        <div class="settings-main">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Profil Bilgileri</h3>
                </div>
                <div class="card-body">
                    <form action="/dashboard/profil" method="POST" class="settings-form">
                        <div class="form-group">
                            <label>Profil Fotoğrafı</label>
                            <div class="avatar-upload">
                                <div class="current-avatar">
                                    <% if (user.avatar) { %>
                                        <img src="<%= user.avatar %>" alt="<%= user.ad_soyad %>">
                                    <% } else { %>
                                        <div class="avatar-placeholder">
                                            <%= user.ad_soyad.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="avatar-info">
                                    <p>Profil fotoğrafı URL'si girin veya sosyal medya hesabınızdan otomatik alınır.</p>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="ad_soyad">Ad Soyad</label>
                            <input type="text" id="ad_soyad" name="ad_soyad" value="<%= user.ad_soyad %>" required>
                        </div>

                        <div class="form-group">
                            <label for="kullanici_adi">Kullanıcı Adı</label>
                            <input type="text" id="kullanici_adi" value="<%= user.kullanici_adi %>" disabled>
                            <small>Kullanıcı adı değiştirilemez</small>
                        </div>

                        <div class="form-group">
                            <label for="email">E-posta</label>
                            <input type="email" id="email" value="<%= user.email %>" disabled>
                            <small>E-posta adresi değiştirilemez</small>
                        </div>

                        <div class="form-group">
                            <label for="bio">Hakkımda</label>
                            <textarea id="bio" name="bio" rows="4" placeholder="Kendinden bahset..."><%= user.bio || '' %></textarea>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="settings-sidebar">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Hesap Durumu</h3>
                </div>
                <div class="card-body">
                    <div class="status-item">
                        <span class="status-label">Üyelik</span>
                        <span class="status-value <%= user.premium_mi ? 'premium' : '' %>">
                            <%= user.premium_mi ? '👑 Premium' : 'Standart' %>
                        </span>
                    </div>
                    <div class="status-item">
                        <span class="status-label">Doğrulama</span>
                        <span class="status-value <%= user.dogrulanmis_mi ? 'verified' : '' %>">
                            <%= user.dogrulanmis_mi ? '✓ Doğrulanmış' : 'Doğrulanmamış' %>
                        </span>
                    </div>
                    <div class="status-item">
                        <span class="status-label">Giriş Yöntemi</span>
                        <span class="status-value">
                            <%= user.giris_yontemi === 'google' ? '🔵 Google' : user.giris_yontemi === 'facebook' ? '🔵 Facebook' : '📧 E-posta' %>
                        </span>
                    </div>
                    <div class="status-item">
                        <span class="status-label">Kayıt Tarihi</span>
                        <span class="status-value">
                            <%= new Date(user.olusturma_tarihi).toLocaleDateString('tr-TR') %>
                        </span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Bağlı Hesaplar</h3>
                </div>
                <div class="card-body">
                    <div class="connected-account">
                        <div class="account-icon google">G</div>
                        <div class="account-info">
                            <div class="account-name">Google</div>
                            <div class="account-status">
                                <%= user.google_id ? 'Bağlı' : 'Bağlı değil' %>
                            </div>
                        </div>
                    </div>
                    <div class="connected-account">
                        <div class="account-icon facebook">f</div>
                        <div class="account-info">
                            <div class="account-name">Facebook</div>
                            <div class="account-status">
                                <%= user.facebook_id ? 'Bağlı' : 'Bağlı değil' %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
